dock# Copy this file to .env. The values below match docker-compose.yml.
DATABASE_URL=postgres://splitsync:splitsync@localhost:5432/splitsync

# Optional: send legacy one-time sign-in codes by email. Leave empty to print them in the server terminal.
SMTP_URL=
MAIL_FROM=SplitSync <no-reply@example.com>

PORT=3001

# Cookies are automatically Secure when NODE_ENV=production; set true when serving HTTPS explicitly.
SESSION_COOKIE_SECURE=false
