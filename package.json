{
  "name": "splitsync",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env server/index.js\" \"vite\"",
    "start": "npm run build && node --env-file-if-exists=.env server/index.js",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "express": "^4.22.3",
    "lucide-react": "^0.462.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}